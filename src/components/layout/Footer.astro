---
const navLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Sobre Nosotros', href: '#nosotros' },
  { label: 'Programas', href: '#programas' },
  { label: 'Patrocinadores', href: '#patrocinadores' },
  { label: 'Galería', href: '#galeria' },
  { label: 'Contacto', href: '#contacto' }
];

const sponsors = ['CityRun (Principal)', 'BikeSport', 'VitaHealth', 'AquaPure', 'SafeGuard'];
---

<footer class="bg-gray-900 dark:bg-black text-white py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div class="space-y-4">
       <div class="flex items-center space-x-3">
          <img 
            src="https://res.cloudinary.com/cx3z2ry1/image/upload/w_100,q_auto,f_auto/Logo_FormaxJ_1_rp0h79.png" 
            alt="FORMAX-J Logo" 
            class="h-12 w-auto"
          />
          <div>
            <span class="text-lg font-bold">Patinaje de Velocidad</span>
          </div>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed">Formando campeones de velocidad sobre ruedas con pasión, disciplina y excelencia desde 2010.</p>
        <div class="flex space-x-3 pt-2">
          {['fa-facebook-f', 'fa-instagram', 'fa-youtube', 'fa-tiktok'].map((icon) => (
            <a href="#" class="w-10 h-10 rounded-xl bg-gray-800 flex items-center justify-center hover:bg-green-600 transition-colors"><i class={`fab ${icon}`}></i></a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="font-semibold text-lg mb-4">Enlaces Rápidos</h4>
        <ul class="space-y-3">
          {navLinks.map((link) => (
            <li><a href={link.href} class="text-gray-400 hover:text-green-400 transition-colors text-sm"><i class="fas fa-chevron-right mr-2 text-xs"></i>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-lg mb-4">Patrocinadores</h4>
        <ul class="space-y-3">
          {sponsors.map((s) => (
            <li><a href="#" class="text-gray-400 hover:text-green-400 transition-colors text-sm"><i class="fas fa-star mr-2 text-xs"></i>{s}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-lg mb-4">Newsletter</h4>
        <p class="text-gray-400 text-sm mb-4">Suscríbete para recibir noticias, eventos y ofertas especiales.</p>
        <form class="space-y-3" onsubmit="event.preventDefault(); this.querySelector('button').textContent='¡Suscrito! ✓'; this.querySelector('button').classList.add('bg-green-600');">
          <input type="email" required placeholder="tu@email.com" class="w-full px-4 py-3 rounded-xl bg-gray-800 border border-gray-700 text-white placeholder-gray-500 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all outline-none text-sm">
          <button type="submit" class="w-full py-3 bg-gradient-to-r from-green-600 to-green-500 text-white rounded-xl font-medium hover:from-green-700 hover:to-green-600 transition-all text-sm">
            <i class="fas fa-bell mr-2"></i>Suscribirme
          </button>
        </form>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-6 mb-6">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <div class="flex items-center space-x-2">
          <span class="text-gray-500 text-sm">Desarrollado con</span>
          <i class="fas fa-heart text-red-500 animate-pulse"></i>
          <span class="text-gray-500 text-sm">por</span>
          <a href="#" class="text-green-400 font-semibold hover:text-green-300 transition-colors">Edward Muñoz</a>
          <span class="text-gray-500 text-sm">| Frontend Developer</span>
        </div>
        <div class="flex items-center space-x-4">
          <a href="#" class="text-gray-500 hover:text-green-400 transition-colors"><i class="fab fa-github text-lg"></i></a>
          <a href="#" class="text-gray-500 hover:text-green-400 transition-colors"><i class="fab fa-linkedin text-lg"></i></a>
          <a href="#" class="text-gray-500 hover:text-green-400 transition-colors"><i class="fas fa-globe text-lg"></i></a>
        </div>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
      <p class="text-gray-500 text-sm">© 2024 Club de Patinaje FORMAX-J. Todos los derechos reservados.</p>
      <div class="flex space-x-6">
        <a href="#" class="text-gray-500 hover:text-green-400 text-sm transition-colors">Política de Privacidad</a>
        <a href="#" class="text-gray-500 hover:text-green-400 text-sm transition-colors">Términos de Uso</a>
        <a href="#" class="text-gray-500 hover:text-green-400 text-sm transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>