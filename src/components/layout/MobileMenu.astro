---
// src/components/layout/MobileMenu.astro
import { mainNav, ctaNav } from '../../data/navigation';
import NavItem from '../shared/NavItem.astro';
import SocialLink from '../shared/SocialLink.astro';
---

<div class="lg:hidden">
  <button 
    id="mobile-menu-btn"
    class="p-2 rounded-lg hover:bg-gray-100 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <!-- Hamburger Icon -->
    <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
  </button>
</div>

<!-- Mobile Menu Overlay -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 z-50 lg:hidden bg-white transform translate-x-full transition-transform duration-300 ease-in-out"
  role="dialog"
  aria-modal="true"
  aria-label="Menú móvil"
>
  <div class="flex flex-col h-full">
    
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-gray-200">
      <span class="font-bold text-lg text-gray-900">Menú</span>
      <button 
        id="mobile-menu-close"
        class="p-2 rounded-lg hover:bg-gray-100 transition-colors"
        aria-label="Cerrar menú"
      >
        <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto py-4 px-6" aria-label="Navegación móvil">
      <ul class="space-y-2">
        {mainNav.map((item) => (
          <li>
            <a 
              href={item.href}
              class="block py-3 px-4 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-lg font-medium transition-colors mobile-nav-link"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Footer -->
    <div class="p-6 border-t border-gray-200 space-y-4">
      <div class="flex items-center gap-3">
        <SocialLink platform="instagram" url="https://instagram.com/formaxj" />
        <SocialLink platform="facebook" url="https://facebook.com/formaxj" />
        <SocialLink platform="youtube" url="https://youtube.com/formaxj" />
      </div>
      <a 
        href={ctaNav.href}
        class="block w-full text-center py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors mobile-cta"
      >
        {ctaNav.label}
      </a>
    </div>
  </div>
</div>

<script>
  // Mobile Menu Logic
  const btn = document.getElementById('mobile-menu-btn');
  const close = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const links = menu?.querySelectorAll('.mobile-nav-link, .mobile-cta');

  function toggleMenu(open: boolean) {
    if (!menu) return;
    menu.classList.toggle('translate-x-full', !open);
    btn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn?.addEventListener('click', () => toggleMenu(true));
  close?.addEventListener('click', () => toggleMenu(false));
  
  // Close on link click or backdrop click
  links?.forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });
  
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) toggleMenu(false);
  });

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('translate-x-full')) {
      toggleMenu(false);
    }
  });
</script>