---
import type { AboutData } from '../../types';
import ImageCloudinary from '../ui/ImageCloudinary.astro';

export interface Props { data: AboutData; }
const { data } = Astro.props;
const colorMap = {
  green: { bg: 'bg-green-100 dark:bg-green-900/30', hover: 'group-hover:bg-green-200 dark:group-hover:bg-green-900/50', icon: 'text-green-600 dark:text-green-400' },
  yellow: { bg: 'bg-yellow-100 dark:bg-yellow-900/30', hover: 'group-hover:bg-yellow-200 dark:group-hover:bg-yellow-900/50', icon: 'text-yellow-600 dark:text-yellow-400' },
  blue: { bg: 'bg-blue-100 dark:bg-blue-900/30', hover: 'group-hover:bg-blue-200 dark:group-hover:bg-blue-900/50', icon: 'text-blue-600 dark:text-blue-400' },
  purple: { bg: 'bg-purple-100 dark:bg-purple-900/30', hover: 'group-hover:bg-purple-200 dark:group-hover:bg-purple-900/50', icon: 'text-purple-600 dark:text-purple-400' }
};
---

<section id="nosotros" class="py-24 bg-white dark:bg-gray-900 relative overflow-hidden speed-lines">
  <div class="absolute top-0 right-0 w-96 h-96 bg-green-100 dark:bg-green-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="section-reveal text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <i class="fas fa-info-circle mr-1"></i> {data.badge}
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4" set:html={data.title}></h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">{data.description}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="section-reveal grid grid-cols-2 gap-4">
        <div class="space-y-4">
          <ImageCloudinary src={data.images[0]} alt="Entrenamiento" class="rounded-2xl shadow-lg w-full h-64 object-cover card-hover" />
          <ImageCloudinary src={data.images[1]} alt="Logo" class="rounded-2xl shadow-lg w-full h-48 object-cover card-hover" />
        </div>
        <div class="space-y-4 pt-8">
          <ImageCloudinary src={data.images[2]} alt="Patinador" class="rounded-2xl shadow-lg w-full h-48 object-cover card-hover" />
          <ImageCloudinary src={data.images[3]} alt="Competición" class="rounded-2xl shadow-lg w-full h-64 object-cover card-hover" />
        </div>
      </div>

      <div class="section-reveal space-y-8">
        <div class="space-y-6">
          {data.features.map((f) => {
            const c = colorMap[f.color];
            return (
              <div class="flex items-start space-x-4 group">
                <div class={`flex-shrink-0 w-14 h-14 rounded-2xl ${c.bg} flex items-center justify-center ${c.hover} transition-colors`}>
                  <i class={`fas ${f.icon} ${c.icon} text-xl`}></i>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">{f.title}</h3>
                  <p class="text-gray-600 dark:text-gray-400">{f.description}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>