---
// src/components/sections/LegalDoc.astro
// Renderiza un documento legal con índice lateral. Lo usan /privacy y /warning-legal.
import type { LegalDocument } from '../../data/legal';

export interface Props {
  doc: LegalDocument;
  /** Muestra el aviso de que el texto es una plantilla pendiente de revisión. */
  borrador?: boolean;
}

const { doc, borrador = true } = Astro.props;
---

<!-- Cabecera -->
<section class="relative pt-32 pb-16 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav aria-label="Ruta" class="text-sm text-gray-400 mb-5">
      <a href="/" class="hover:text-green-400 transition-colors">Inicio</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-gray-300">{doc.title}</span>
    </nav>
    <h1 class="font-display text-3xl sm:text-5xl font-bold text-white leading-tight">{doc.title}</h1>
    <p class="text-green-400 font-semibold mt-3">{doc.subtitle}</p>
    <p class="text-sm text-gray-400 mt-4">
      <i class="fas fa-calendar-day mr-2" aria-hidden="true"></i>Última actualización: {doc.updated}
    </p>
  </div>
</section>

<section class="py-16 bg-white dark:bg-gray-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    {borrador && (
      <div class="mb-10 rounded-2xl bg-yellow-50 dark:bg-yellow-900/20 border-l-4 border-yellow-500 p-5">
        <p class="text-sm text-yellow-900 dark:text-yellow-100 leading-relaxed">
          <strong><i class="fas fa-triangle-exclamation mr-2" aria-hidden="true"></i>Documento modelo.</strong>
          Redactado sobre la normativa colombiana vigente, pero pendiente de revisión por un abogado
          y de completar los datos marcados como <strong>PENDIENTE</strong>. No publicar como
          definitivo sin esa validación.
        </p>
      </div>
    )}

    <div class="grid lg:grid-cols-12 gap-10">
      <!-- Índice -->
      <nav aria-labelledby="toc-title" class="lg:col-span-4 order-2 lg:order-1">
        <div class="lg:sticky lg:top-28 rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-5">
          <h2 id="toc-title" class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
            Contenido
          </h2>
          <ol class="space-y-2 text-sm">
            {doc.sections.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="block py-1 text-gray-600 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 transition-colors"
                >
                  {s.title}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </nav>

      <!-- Cuerpo -->
      <div class="lg:col-span-8 order-1 lg:order-2">
        <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed mb-10 pb-10 border-b border-gray-200 dark:border-gray-700">
          {doc.intro}
        </p>

        {doc.sections.map((s) => (
          <article class="legal-section mb-10 scroll-mt-28" id={s.id}>
            <h2 class="font-display text-2xl font-bold text-gray-900 dark:text-white mb-4">{s.title}</h2>
            <div class="legal-body text-gray-700 dark:text-gray-300 leading-relaxed" set:html={s.body} />
          </article>
        ))}

        <div class="mt-12 p-6 rounded-2xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
          <h2 class="font-bold text-gray-900 dark:text-white mb-2">¿Dudas sobre tus datos?</h2>
          <p class="text-sm text-gray-700 dark:text-gray-300 mb-4">
            Escríbenos y te respondemos dentro de los plazos de ley.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:formaxxj@gmail.com"
              class="inline-flex items-center px-5 py-2.5 rounded-full bg-green-600 text-white text-sm font-semibold hover:bg-green-700 transition-colors"
            >
              <i class="fas fa-envelope mr-2" aria-hidden="true"></i>Escribir correo
            </a>
            <a
              href="https://wa.me/573122461761"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center px-5 py-2.5 rounded-full border border-green-600 text-green-700 dark:text-green-400 text-sm font-semibold hover:bg-green-50 dark:hover:bg-green-900/30 transition-colors"
            >
              <i class="fab fa-whatsapp mr-2" aria-hidden="true"></i>WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Tipografía del cuerpo legal: el HTML viene de src/data/legal.ts */
  .legal-body p { margin-bottom: 1rem; }
  .legal-body ul { margin: 0 0 1rem 1.25rem; list-style: disc; }
  .legal-body li { margin-bottom: 0.5rem; padding-left: 0.25rem; }
  .legal-body strong { color: #111827; font-weight: 700; }
  .dark .legal-body strong { color: #fff; }
  .legal-body a { color: #16a34a; text-decoration: underline; text-underline-offset: 2px; }
  .legal-body a:hover { color: #15803d; }
</style>
