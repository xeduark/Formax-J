---
// src/components/sections/Methodology.astro
export interface Props { data: any; }
const { data } = Astro.props;
---

<section id="metodologia" class="py-24 bg-white dark:bg-gray-900 relative overflow-hidden">
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-green-500 via-yellow-400 to-green-500"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="section-reveal text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <i class="fas fa-graduation-cap mr-1"></i> Metodología & Formación
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Ciencia, disciplina y <span class="gradient-text">pasión deportiva</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto italic border-l-4 border-green-500 pl-4 text-left bg-gray-50 dark:bg-gray-800/50 py-4 px-6 rounded-r-xl">
        "{data.quote.text}"<br>
        <span class="text-sm text-gray-500 dark:text-gray-400 mt-2 block">— {data.quote.author}, {data.quote.role}</span>
      </p>
    </div>

    <!-- Beneficios OMS -->
    <div class="section-reveal grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-20">
      {data.omsBenefits.map((b: any, i: number) => (
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-5 text-center hover:shadow-lg transition-shadow border border-gray-100 dark:border-gray-700">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600 dark:text-green-400">
            <i class={`fas ${b.icon} text-xl`}></i>
          </div>
          <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-1">{b.title}</h4>
          <p class="text-xs text-gray-600 dark:text-gray-400">{b.desc}</p>
        </div>
      ))}
    </div>

    <!-- Estructura Anual -->
    <div class="section-reveal mb-20">
      <h3 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-8">
        <i class="fas fa-calendar-check text-green-500 mr-2"></i> Estructura de Temporada
      </h3>
      <div class="bg-gradient-to-r from-green-50 to-yellow-50 dark:from-green-900/20 dark:to-yellow-900/20 rounded-2xl p-6 md:p-8 border border-green-100 dark:border-green-800">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center mb-8">
          <div>
            <div class="text-3xl font-extrabold text-green-600 dark:text-green-400">{data.structure.sessionsYear}</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Sesiones/año</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-green-600 dark:text-green-400">{data.structure.sessionsWeek}</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Sesiones/semana</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-green-600 dark:text-green-400">{data.structure.weeksYear}</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Semanas activas</div>
          </div>
          <div>
            <div class="text-3xl font-extrabold text-green-600 dark:text-green-400">4</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Mesociclos</div>
          </div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {data.structure.mesocycles.map((m: any) => (
            <div class="bg-white dark:bg-gray-900 rounded-xl p-5 shadow-sm border border-gray-100 dark:border-gray-700 relative overflow-hidden">
              <div class="absolute top-0 left-0 w-1 h-full bg-gradient-to-b from-green-500 to-yellow-400"></div>
              <span class="inline-block px-2 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-xs font-bold rounded-full mb-2">Fase {m.num}</span>
              <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-2">{m.name}</h4>
              <p class="text-xs text-gray-600 dark:text-gray-400">{m.focus}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Niveles de Formación -->
    <div class="section-reveal">
      <h3 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-8">
        <i class="fas fa-layer-group text-green-500 mr-2"></i> Ruta de Formación
      </h3>
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-0">
        {data.levels.map((lvl: any, i: number) => (
          <div class="flex items-center w-full md:w-auto">
            <div class={`bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-md border border-gray-100 dark:border-gray-700 w-full md:w-64 text-center hover:scale-105 transition-transform ${lvl.color === 'green' ? 'border-l-4 border-l-green-500' : lvl.color === 'blue' ? 'border-l-4 border-l-blue-500' : lvl.color === 'yellow' ? 'border-l-4 border-l-yellow-500' : 'border-l-4 border-l-purple-500'}`}>
              <h4 class="font-bold text-gray-900 dark:text-white mb-1">{lvl.name}</h4>
              <p class="text-xs text-gray-500 dark:text-gray-400 mb-2"><i class="fas fa-map-marker-alt mr-1"></i>{lvl.locations}</p>
              <p class="text-xs text-gray-600 dark:text-gray-300 font-medium">{lvl.focus}</p>
            </div>
            {i < data.levels.length - 1 && (
              <div class="hidden md:flex mx-4 text-gray-400"><i class="fas fa-arrow-right text-2xl"></i></div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('#metodologia .section-reveal').forEach(el => observer.observe(el));
  });
</script>