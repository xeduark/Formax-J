---
// src/components/sections/Programs.astro
export interface Props { 
  data: Array<{
    id: string;
    title: string;
    age: string;
    freq: string;
    desc: string;
    price: string;
    icon: string;
    gradient: string;
    popular?: boolean;
  }>; 
}

const { data } = Astro.props;

// ✅ Número de WhatsApp del club (formato internacional sin +)
const whatsappNumber = '573003766780'; 
---

<section id="programas" class="py-24 bg-gray-50 dark:bg-gray-800 relative track-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Header -->
    <div class="section-reveal text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <i class="fas fa-star mr-1"></i> Nuestros Programas
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Elige tu <span class="gradient-text">categoría</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Desde primeros pasos sobre patines de velocidad hasta competición de élite internacional.
      </p>
    </div>

    <!-- Programs Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.map((program) => (
        <div 
          class={`section-reveal card-hover bg-white dark:bg-gray-900 rounded-3xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-700 relative group ${
            program.popular ? 'ring-2 ring-green-500/20' : ''
          }`}
        >
          {program.popular && (
            <div class="absolute top-4 right-4 z-10">
              <span class="px-3 py-1 bg-gradient-to-r from-yellow-400 to-yellow-500 text-white text-xs font-bold rounded-full shadow-md">
                <i class="fas fa-fire mr-1"></i> Popular
              </span>
            </div>
          )}
          
          <div class={`h-48 bg-gradient-to-br ${program.gradient} flex items-center justify-center relative overflow-hidden`}>
            <div class="absolute inset-0 bg-black/10"></div>
            <i class="fas fa-rocket text-white/20 text-8xl absolute -bottom-4 -right-4 group-hover:scale-110 transition-transform duration-500"></i>
            <div class="relative text-center z-10">
              <i class={`fas ${program.icon} text-white text-4xl mb-2`}></i>
              <h3 class="text-2xl font-bold text-white">{program.title}</h3>
            </div>
          </div>
          
          <div class="p-6 space-y-4">
            <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
              <i class="fas fa-users mr-2 text-green-500"></i><span>{program.age}</span>
              <span class="mx-2">•</span>
              <i class="fas fa-clock mr-2 text-green-500"></i><span>{program.freq}</span>
            </div>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{program.desc}</p>
            <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
              <span class="text-2xl font-bold text-green-600 dark:text-green-400">{program.price}<span class="text-sm font-normal text-gray-500 dark:text-gray-400">/mes</span></span>
              
              {/* ✅ BOTÓN WHATSAPP CON MENSAJE FORMAL PREDEFINIDO */}
              <a 
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
                  `Estimado equipo de FORMAX-J, me pongo en contacto con ustedes porque estoy interesado/a en formar parte del equipo y conocer más detalles sobre el programa: ${program.title} Agradezco de antemano la información que puedan brindarme sobre requisitos, horarios disponibles y proceso de inscripción. Quedo atento/a a su respuesta.`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-full text-sm font-medium transition-colors shadow-md hover:shadow-lg inline-flex items-center gap-2"
              >
                <i class="fab fa-whatsapp"></i> Info
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // ✅ Solo animación de reveal, sin lógica de formulario
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('#programas .section-reveal').forEach(el => observer.observe(el));
  });
</script>