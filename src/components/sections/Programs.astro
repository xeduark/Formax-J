---
import RegistrationCardAstroComponent from "../ui/RegistrationCard.astro";
import { registrationData } from "@/data/registration";
import ProgramCard from "../ui/ProgramCard.astro";

export interface Props {
  data: Array<{
    id: string;
    title: string;
    age: string;
    freq: string;
    desc: string;
    price: string;
    icon: string;
    gradient: string;
    popular?: boolean;
    level: string;
    methodologyFocus: string;
    details: string[];
  }>;
}

const { data } = Astro.props;
---

<section id="programas" class="py-24 bg-gray-50 dark:bg-gray-800 relative track-bg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="section-reveal text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <i class="fas fa-star mr-1"></i> Nuestros Programas
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Elige tu <span class="gradient-text">categoría</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Desde primeros pasos sobre patines de velocidad hasta competición de élite internacional.
      </p>
    </div>

    <div class="section-reveal mb-12">
      <RegistrationCardAstroComponent data={registrationData} />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.map((program) => (
        <div 
          class="section-reveal card-hover bg-white dark:bg-gray-900 rounded-3xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-700 relative group cursor-pointer"
          data-program-id={program.id}
          onclick="openProgramModal(this.dataset.programId)"
        >
          {program.popular && (
            <div class="absolute top-4 right-4 z-10">
              <span class="px-3 py-1 bg-gradient-to-r from-yellow-400 to-yellow-500 text-white text-xs font-bold rounded-full shadow-md">
                <i class="fas fa-fire mr-1"></i> Popular
              </span>
            </div>
          )}
          
          <div class={`h-48 bg-gradient-to-br ${program.gradient} flex items-center justify-center relative overflow-hidden`}>
            <div class="absolute inset-0 bg-black/10"></div>
            <i class="fas fa-rocket text-white/20 text-8xl absolute -bottom-4 -right-4 group-hover:scale-110 transition-transform duration-500"></i>
            <div class="relative text-center z-10">
              <i class={`fas ${program.icon} text-white text-4xl mb-2`}></i>
              <h3 class="text-2xl font-bold text-white">{program.title}</h3>
            </div>
          </div>
          
          <div class="p-6 space-y-4">
            <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-400">
              <span class="flex items-center gap-1"><i class="fas fa-users text-green-500"></i>{program.age}</span>
              <span class="px-2 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-xs font-bold">{program.level.split('/')[0].trim()}</span>
            </div>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed line-clamp-3">{program.desc}</p>
            <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
              <span class="text-2xl font-bold text-green-600 dark:text-green-400">{program.price}<span class="text-sm font-normal text-gray-500 dark:text-gray-400">/mes</span></span>
              <button class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-full text-sm font-medium transition-colors shadow-md hover:shadow-lg inline-flex items-center gap-2">
                Ver detalle <i class="fas fa-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* Modales (se generan dinámicamente o se insertan aquí) */}
  {data.map((program) => (
    <div id={`modal-${program.id}`} class="fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300">
      <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick={`closeProgramModal('${program.id}')`}></div>
     <div class="modal-content relative bg-white dark:bg-gray-900 rounded-3xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto border border-gray-200 dark:border-gray-700 transform scale-95 transition-transform duration-300">
        <button class="absolute top-4 right-4 w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors z-10" onclick={`closeProgramModal('${program.id}')`}>
          <i class="fas fa-times text-gray-600 dark:text-gray-300"></i>
        </button>
        <div class="p-6 md:p-8">
          <div class={`h-24 rounded-2xl bg-gradient-to-br ${program.gradient} flex items-center justify-center mb-6 relative overflow-hidden`}>
            <i class="fas fa-rocket text-white/20 text-6xl absolute -bottom-2 -right-2"></i>
            <h3 class="text-2xl font-bold text-white relative z-10 text-center px-4">{program.title}</h3>
          </div>
          <div class="flex items-center justify-center mb-6">
            <span class="px-4 py-1.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-bold border border-green-200 dark:border-green-800">
              <i class="fas fa-layer-group mr-1"></i> Nivel: {program.level}
            </span>
          </div>
          <div class="grid grid-cols-2 gap-4 mb-6 text-center">
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl">
              <i class="fas fa-users text-green-500 mb-1"></i>
              <p class="text-xs text-gray-500 dark:text-gray-400">Edad</p>
              <p class="font-semibold text-gray-900 dark:text-white text-sm">{program.age}</p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl">
              <i class="fas fa-clock text-green-500 mb-1"></i>
              <p class="text-xs text-gray-500 dark:text-gray-400">Frecuencia</p>
              <p class="font-semibold text-gray-900 dark:text-white text-sm">{program.freq}</p>
            </div>
            <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl col-span-2">
              <i class="fas fa-calendar-alt text-green-500 mb-1"></i>
              <p class="text-xs text-gray-500 dark:text-gray-400">Enfoque Metodológico</p>
              <p class="font-semibold text-gray-900 dark:text-white text-sm">{program.methodologyFocus}</p>
            </div>
          </div>
          <div class="mb-6">
            <h4 class="font-bold text-gray-900 dark:text-white mb-2">¿Qué aprenderás?</h4>
            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{program.desc}</p>
            <ul class="mt-3 space-y-2">
              {program.details?.map((d: string) => (
                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
                  <i class="fas fa-check text-green-500 mt-1 text-xs"></i> {d}
                </li>
              ))}
            </ul>
          </div>
          <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
            <div>
              <span class="text-2xl font-bold text-green-600 dark:text-green-400">{program.price}</span>
              <span class="text-sm text-gray-500 dark:text-gray-400">/mes</span>
            </div>
            <a 
              href={`https://wa.me/573001234567?text=${encodeURIComponent(`Hola FORMAX-J, me interesa el programa: ${program.title} (Nivel: ${program.level}). Quisiera información de inscripción.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-full font-semibold text-sm transition-colors shadow-lg hover:shadow-green-500/30 inline-flex items-center gap-2"
            >
              <i class="fab fa-whatsapp"></i> Inscribirme
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}
</section>

<script is:inline>
  // Modal Logic
  function openProgramModal(id) {
    const modal = document.getElementById(`modal-${id}`);

    if (!modal) {
      console.error(`No se encontró el modal: modal-${id}`);
      return;
    }

    const modalContent = modal.querySelector('.modal-content');

    if (!modalContent) {
      console.error(`No se encontró .modal-content dentro de modal-${id}`);
      return;
    }

    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');

    modalContent.classList.remove('scale-95');
    modalContent.classList.add('scale-100');

    document.body.style.overflow = 'hidden';
  }

  function closeProgramModal(id) {
    const modal = document.getElementById(`modal-${id}`);

    if (!modal) {
      console.error(`No se encontró el modal: modal-${id}`);
      return;
    }

    const modalContent = modal.querySelector('.modal-content');

    if (!modalContent) {
      console.error(`No se encontró .modal-content dentro de modal-${id}`);
      return;
    }

    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');

    modalContent.classList.remove('scale-100');
    modalContent.classList.add('scale-95');

    document.body.style.overflow = '';
  }

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[id^="modal-"]').forEach(modal => {
        if (!modal.classList.contains('opacity-0')) {
          const id = modal.id.replace('modal-', '');
          closeProgramModal(id);
        }
      });
    }
  });

  // Section Reveal
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    document
      .querySelectorAll('#programas .section-reveal')
      .forEach(el => observer.observe(el));
  });
</script>