---
import type { ScheduleData } from '../../types/schedule';
import SectionHeader from '../ui/schedule/SectionHeader.astro';
import AlertNote from '../ui/schedule/AlertNote.astro';
import DayCard from '../ui/schedule/DayCard.astro';
import ScheduleLegend from '../ui/schedule/ScheduleLegend.astro';
import FooterNote from '../ui/schedule/FooterNote.astro';

export interface Props { data: ScheduleData; }
const { data } = Astro.props;
---

<section id="horarios" class="py-24 bg-white dark:bg-gray-900 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-green-100/50 dark:bg-green-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-100/50 dark:bg-yellow-900/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <SectionHeader badge={data.badge} title="Planifica tu semana" subtitle={data.subtitle} />
    {data.note && <AlertNote message={data.note} variant="warning" />}

    <div class="section-reveal grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4 lg:gap-5 items-stretch">
      {data.days.map((day) => <DayCard day={day} />)}
    </div>

    <ScheduleLegend items={[
      { label: 'Mañana', color: 'bg-green-500' },
      { label: 'Tarde', color: 'bg-yellow-500' },
      { label: 'Sábados: Confirmar sede semanal', color: 'text-yellow-500', icon: 'fa-exclamation-circle' }
    ]} />

    {data.footerNote && <FooterNote html={data.footerNote} />}
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('#horarios .section-reveal').forEach(el => observer.observe(el));
  });
</script>