---
// src/components/sections/Schedule.astro
export interface Props { data: any; }
const { data } = Astro.props;
---

<section id="horarios" class="py-24 bg-white dark:bg-gray-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="section-reveal text-center mb-12">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <i class="fas fa-calendar-alt mr-1"></i> {data.badge || 'Horarios de Entrenamiento'}
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Planifica tu <span class="gradient-text">semana</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Entrenamientos en pista y calle organizados para maximizar tu rendimiento.
      </p>
    </div>

    {/* ✅ 1. TARJETA DE ENFAIS: INSCRIPCIÓN */}
    {data.registration && (
      <div class="section-reveal mb-12 max-w-4xl mx-auto">
        <div class="bg-gradient-to-br from-green-50 to-yellow-50 dark:from-green-900/20 dark:to-yellow-900/20 border border-green-200 dark:border-green-800 rounded-2xl p-6 md:p-8 relative overflow-hidden shadow-lg">
          <!-- Decoración de fondo -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-green-400/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"></div>
          
          <div class="flex flex-col md:flex-row items-start md:items-center gap-6 relative z-10">
            
            <!-- Caja del Precio -->
            <div class="flex-shrink-0 text-center md:text-left bg-white dark:bg-gray-800 rounded-xl p-5 shadow-sm border border-green-100 dark:border-green-900/50 min-w-[180px]">
              <p class="text-xs font-bold text-green-600 dark:text-green-400 uppercase tracking-wider mb-1">Inscripción Única</p>
              <div class="text-4xl font-extrabold text-gray-900 dark:text-white">{data.registration.price}</div>
              <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Pago único anual</p>
            </div>
            
            <!-- Lista de lo que incluye -->
            <div class="flex-1">
              <p class="font-semibold text-gray-800 dark:text-gray-100 mb-3 flex items-center gap-2">
                <i class="fas fa-gift text-yellow-500"></i> ¿Qué incluye tu inscripción?
              </p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4">
                {data.registration.includes.map((item: string) => (
                  <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
                    <i class="fas fa-check-circle text-green-500 text-xs"></i> {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          
          {/* Nota aclaratoria (Lo que NO incluye) */}
          <div class="mt-6 pt-4 border-t border-green-200/60 dark:border-green-800/60 text-xs text-gray-500 dark:text-gray-400 flex items-start gap-2 bg-white/50 dark:bg-gray-900/30 p-3 rounded-lg">
            <i class="fas fa-info-circle text-blue-500 mt-0.5"></i>
            <span>
              <strong>Nota:</strong> La inscripción es un pago único. Las mensualidades se pagan por separado y cubren únicamente los entrenamientos. 
              <span class="text-gray-700 dark:text-gray-300 font-medium">No incluye patines, protectores, hidratación ni alimentación.</span>
            </span>
          </div>
        </div>
      </div>
    )}

    {/* ✅ 3. TABLA DE HORARIOS */}
    <div class="section-reveal overflow-x-auto rounded-3xl shadow-xl border border-gray-100 dark:border-gray-700">
      <table class="w-full bg-white dark:bg-gray-800 rounded-3xl overflow-hidden min-w-[800px]">
        <thead>
          <tr class="bg-gradient-to-r from-green-600 to-green-500 text-white">
            {data.headers.map((h: string) => (
              <th class="py-5 px-6 text-center font-semibold text-sm uppercase tracking-wider">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {data.rows.map((row: any) => (
            <tr class="border-b border-gray-100 dark:border-gray-700 hover:bg-green-50 dark:hover:bg-green-900/10 transition-colors">
              <td class={`py-4 px-6 font-semibold ${row.color}`}><i class={`fas ${row.icon} mr-2`}></i>{row.time}</td>
              {row.data.map((cell: string) => (
                <td class="py-4 px-6 text-center text-sm text-gray-600 dark:text-gray-400" set:html={cell}></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {/* Leyenda */}
    <div class="section-reveal mt-8 flex flex-wrap justify-center gap-6 text-sm text-gray-500 dark:text-gray-400">
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-green-500"></span>Mañana</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-yellow-500"></span>Tarde</span>
      <span>Los horarios pueden ajustarse por clima o eventos oficiales</span>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('#horarios .section-reveal').forEach(el => observer.observe(el));
  });
</script>