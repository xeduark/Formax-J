---
// src/components/ScheduleGrid.astro
// Componente principal para mostrar horarios en formato de tarjetas.
// Compatible con datos externos (Excel/JSON/Sheets) via Astro.props.

import type { DaySchedule, ScheduleGridProps } from '../../types/schedule';

// Configuración de props por defecto
const {
  days = [],
  title = 'Horarios de Entrenamiento',
  subtitle = 'Formación integral: 46-47 semanas de temporada',
  footerNote,
  showRegistration = true,
  registration,
  showMonthlyPlans = true,
  monthlyPlans,
} = Astro.props as ScheduleGridProps;
---

<section id="horarios-grid" class="py-24 bg-white dark:bg-gray-900 relative overflow-hidden">
  <!-- Decoración de fondo sutil -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-green-100/50 dark:bg-green-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-100/50 dark:bg-yellow-900/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    {/* ==========================================
        1. HEADER DE LA SECCIÓN
    ========================================== */}
    <div class="section-reveal text-center mb-16">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-semibold mb-6 border border-green-200 dark:border-green-800">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
        </span>
        Horarios Confirmados
      </span>
      
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
        {title}
      </h2>
      
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-2">
        {subtitle}
      </p>
      
      <!-- Cita Opcional del PDF -->
      <blockquote class="mt-6 text-xs sm:text-sm font-medium italic text-gray-500 dark:text-gray-500 max-w-xl mx-auto border-l-2 border-green-500 pl-4 text-left">
        "La Educación Física es una práctica pedagógica centrada en la conducta motriz..." <br>
        <span class="not-italic font-bold text-gray-700 dark:text-gray-400">— Pierre Parlebas</span>
      </blockquote>
    </div>

    {/* ==========================================
        2. INFORMACIÓN DE INSCRIPCIÓN (Opcional)
    ========================================== */}
    {showRegistration && registration && (
      <div class="section-reveal mb-12 max-w-4xl mx-auto">
        <div class="relative group rounded-2xl overflow-hidden shadow-xl border border-green-100 dark:border-green-900/50">
          <!-- Gradiente de fondo -->
          <div class="absolute inset-0 bg-gradient-to-br from-green-50 via-yellow-50 to-white dark:from-green-900/20 dark:via-gray-900 dark:to-gray-800"></div>
          
          <div class="relative p-6 md:p-8 flex flex-col md:flex-row items-center gap-8">
            <!-- Icono / Decoración -->
            <div class="flex-shrink-0 w-20 h-20 bg-gradient-to-br from-green-400 to-green-600 rounded-full flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform duration-300">
              <i class="fas fa-id-card text-3xl text-white"></i>
            </div>
            
            <div class="flex-1 text-center md:text-left">
              <h3 class="font-display text-xl font-bold text-gray-900 dark:text-white mb-1">Inscripción Única Anual</h3>
              <div class="flex items-baseline gap-1 justify-center md:justify-start">
                <span class="text-3xl font-extrabold text-green-600 dark:text-green-400">{registration.price}</span>
                <span class="text-sm text-gray-500 font-medium">Pago único</span>
              </div>
              <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-y-1 gap-x-4 text-xs text-gray-600 dark:text-gray-400">
                {registration.includes.map((item) => (
                  <li class="flex items-center gap-2">
                    <i class="fas fa-check-circle text-green-500"></i> {item}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Nota de exclusión -->
            <div class="bg-white/60 dark:bg-black/20 backdrop-blur-sm p-3 rounded-lg text-[10px] text-gray-600 dark:text-gray-300 leading-relaxed max-w-xs border border-gray-200 dark:border-gray-700">
              <i class="fas fa-exclamation-circle text-yellow-500 mr-1"></i>
              No incluye patines, protecciones ni alimentación.
            </div>
          </div>
        </div>
      </div>
    )}

    {/* ==========================================
        3. MENSLUALIDADES / PRECIOS (Opcional)
    ========================================== */}
    {showMonthlyPlans && monthlyPlans && (
      <div class="section-reveal grid grid-cols-1 sm:grid-cols-2 gap-6 mb-16 max-w-3xl mx-auto">
        {monthlyPlans.map((plan, i) => (
          <div class="relative bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700 hover:border-green-400 transition-colors group">
            <div class={`absolute top-0 left-0 w-1.5 h-full rounded-l-2xl ${i === 0 ? 'bg-green-500' : 'bg-yellow-500'}`}></div>
            
            <div class="flex justify-between items-start mb-2">
              <h4 class="font-bold text-lg text-gray-900 dark:text-white">{plan.name}</h4>
              <span class="text-xs font-bold px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded-md text-gray-600 dark:text-gray-300">{plan.days}</span>
            </div>
            
            <div class="flex items-end gap-1 mb-3">
              <span class="text-3xl font-extrabold text-gray-900 dark:text-white">{plan.price.split('/')[0]}</span>
              <span class="text-sm text-gray-500 mb-1">/{plan.price.split('/')[1]}</span>
            </div>
            
            <p class="text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
              <i class="fas fa-map-marker-alt text-gray-400"></i> {plan.location}
            </p>
          </div>
        ))}
      </div>
    )}

    {/* ==========================================
        4. GRID DE HORARIOS SEMANALES
    ========================================== */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
      {days.map((day: DaySchedule) => {
        const isSpecial = day.isSpecial;
        
        // Estilos condicionales según el tipo de día (Básico vs Pista)
        const headerStyles = isSpecial 
          ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-blue-500/20' 
          : 'bg-gray-900 dark:bg-gray-800 text-white';
        
        const cardBorder = isSpecial 
          ? 'border-blue-200 dark:border-blue-900' 
          : 'border-gray-100 dark:border-gray-700';
        
        const cardBg = isSpecial 
          ? 'bg-blue-50/30 dark:bg-blue-900/10' 
          : 'bg-gray-50/50 dark:bg-gray-800/30';

        return (
          <div 
            class={`section-reveal rounded-2xl border ${cardBorder} ${cardBg} shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden backdrop-blur-sm`}
          >
            {/* Cabecera del Día */}
            <div class={`p-4 border-b border-white/10 ${headerStyles} flex flex-col justify-center min-h-[80px]`}>
              <div class="flex items-center justify-between mb-1">
                <h3 class="font-display text-xl font-bold tracking-wide uppercase">{day.dayName}</h3>
                {isSpecial && (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/20 backdrop-blur-md animate-pulse">
                    PISTA
                  </span>
                )}
              </div>
              <p class="text-xs font-medium opacity-90">{day.subtitle}</p>
            </div>

            {/* Lista de Clases (Slots) */}
            <div class="p-4 space-y-4 flex-1 flex flex-col justify-start">
              {day.slots.map((slot, index) => {
                // Lógica de colores para sedes
                const isGirardota = slot.location.includes('Girardota');
                const isHatillo = slot.location.includes('Hatillo');
                const isBarbosa = slot.location.includes('Barbosa');
                
                const locColor = isGirardota 
                  ? { bg: 'bg-blue-100 dark:bg-blue-900/40', text: 'text-blue-700 dark:text-blue-300', border: 'border-blue-200 dark:border-blue-800', icon: 'text-blue-500' }
                  : isHatillo 
                  ? { bg: 'bg-yellow-100 dark:bg-yellow-900/40', text: 'text-yellow-700 dark:text-yellow-300', border: 'border-yellow-200 dark:border-yellow-800', icon: 'text-yellow-500' }
                  : { bg: 'bg-green-100 dark:bg-green-900/40', text: 'text-green-700 dark:text-green-300', border: 'border-green-200 dark:border-green-800', icon: 'text-green-500' }; // Default Barbosa

                return (
                  <div class="relative group">
                    {/* Conector visual entre slots del mismo día */}
                    {index < day.slots.length - 1 && (
                      <div class="absolute left-[11px] top-8 bottom-[-16px] w-0.5 bg-gray-200 dark:bg-gray-700"></div>
                    )}

                    <div class={`relative flex gap-3 p-3 rounded-xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow`}>
                      {/* Hora (Izquierda) */}
                      <div class="flex flex-col items-center justify-center w-10 h-10 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700 flex-shrink-0">
                        <i class={`fas fa-clock ${locColor.icon} text-xs`}></i>
                        <span class="text-[10px] font-bold text-gray-600 dark:text-gray-300 mt-0.5">{slot.time.split(' ')[0]}</span>
                      </div>
                      
                      {/* Info (Derecha) */}
                      <div class="flex-1 flex flex-col justify-center">
                        <span class="text-sm font-bold text-gray-800 dark:text-white leading-none mb-1.5">{slot.time}</span>
                        
                        {/* Badge de Sede */}
                        <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-[10px] font-bold border ${locColor.bg} ${locColor.text} ${locColor.border} w-fit`}>
                          <i class="fas fa-map-pin text-[8px]"></i>
                          {slot.location}
                        </span>

                        {/* Estado o Nota (Footer del slot) */}
                        {(slot.statusText || slot.notes) && (
                          <p class={`mt-2 text-[10px] leading-snug ${isSpecial ? 'text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-400'}`}>
                            {slot.statusText || slot.notes}
                          </p>
                        )}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    {/* ==========================================
        5. NOTA AL PIE / FOOTER NOTE
    ========================================== */}
    {footerNote && (
      <div class="section-reveal mt-12 p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-center">
        <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed" set:html={footerNote}></p>
      </div>
    )}
  </div>
</section>

<script is:inline>
  // Animación de entrada (Intersection Observer)
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target); // Animación solo una vez
        }
      });
    }, { 
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.querySelectorAll('#horarios-grid .section-reveal').forEach(el => {
      observer.observe(el);
    });
  });
</script>