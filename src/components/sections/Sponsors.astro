---
export interface Props { data: any; }
const { data } = Astro.props;

const productColors: Record<string, string> = {
  orange: 'from-orange-100 to-orange-200 dark:from-orange-900/30 dark:to-orange-800/30 text-orange-500',
  red: 'from-red-100 to-red-200 dark:from-red-900/30 dark:to-red-800/30 text-red-500',
  yellow: 'from-yellow-100 to-yellow-200 dark:from-yellow-900/30 dark:to-yellow-800/30 text-yellow-500',
  blue: 'from-blue-100 to-blue-200 dark:from-blue-900/30 dark:to-blue-800/30 text-blue-500'
};
---

<section id="patrocinadores" class="py-24 bg-gray-50 dark:bg-gray-800 relative overflow-hidden">
  <div class="absolute inset-0 track-bg opacity-50"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="section-reveal text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
        <i class="fas fa-handshake mr-1"></i> {data.badge || 'Nuestros Patrocinadores'}
      </span>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Impulsados por <span class="gradient-text">grandes marcas</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Contamos con el respaldo de marcas líderes que comparten nuestra pasión por el patinaje de velocidad.
      </p>
    </div>

    <!-- Patrocinador Principal -->
    <div class="section-reveal mb-12">
      <div class="bg-white dark:bg-gray-900 rounded-3xl p-8 shadow-xl border border-gray-100 dark:border-gray-700 max-w-3xl mx-auto">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="flex-shrink-0">
            <div class={`w-32 h-32 rounded-2xl bg-gradient-to-br ${data.main.gradient} flex items-center justify-center shadow-lg`}>
              <i class={`fas ${data.main.icon} text-white text-5xl`}></i>
            </div>
          </div>
          <div class="text-center md:text-left">
            <span class="inline-block px-3 py-1 bg-gradient-to-r from-orange-500 to-red-500 text-white text-xs font-bold rounded-full mb-3">
              <i class="fas fa-star mr-1"></i> Patrocinador Principal
            </span>
            <h3 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">{data.main.name}</h3>
            <p class="text-gray-600 dark:text-gray-400 mb-4">{data.main.desc}</p>
            <a href={data.main.url} target="_blank" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-orange-500 to-red-500 text-white rounded-full font-medium hover:from-orange-600 hover:to-red-600 transition-all duration-300 shadow-lg hover:shadow-orange-500/30">
              <i class="fas fa-external-link-alt mr-2"></i>Visitar {data.main.name}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Productos -->
    <div class="section-reveal mb-16">
      <h3 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-8">
        <i class="fas fa-shopping-bag text-green-500 mr-2"></i>Productos {data.main.name} Recomendados
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {data.products.map((p: any) => (
          <div class="bg-white dark:bg-gray-900 rounded-2xl p-6 shadow-lg border border-gray-100 dark:border-gray-700 card-hover text-center group">
            <div class={`w-20 h-20 mx-auto mb-4 rounded-full bg-gradient-to-br ${productColors[p.color]} flex items-center justify-center group-hover:scale-110 transition-transform`}>
              <i class={`fas ${p.icon} text-3xl`}></i>
            </div>
            <h4 class="font-bold text-gray-900 dark:text-white text-sm mb-1">{p.name}</h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">{p.desc}</p>
            <span class="text-lg font-bold text-green-600 dark:text-green-400">{p.price}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Secundarios -->
    <div class="section-reveal">
      <h3 class="text-xl font-bold text-center text-gray-900 dark:text-white mb-8">También nos apoyan</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {data.secondary.map((s: any) => (
          <div class="sponsor-card bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-lg border border-gray-100 dark:border-gray-700 flex items-center justify-center h-32">
            <div class="text-center">
              <i class={`fas ${s.icon} text-4xl ${s.color} mb-2`}></i>
              <p class="font-bold text-sm text-gray-700 dark:text-gray-300">{s.name}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>