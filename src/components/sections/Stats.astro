---
// src/components/sections/Stats.astro
export interface Props { 
  data: Array<{
    icon: string;
    value: string;
    label: string;
  }>; 
}

const { data } = Astro.props;
---

<section class="py-24 bg-gradient-to-r from-green-600 via-green-500 to-yellow-500 relative overflow-hidden">
  <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.05%22%3E%3Cpath%20d%3D%22M36%2034v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6%2034v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6%204V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')]"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="section-reveal text-center mb-16">
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-white mb-4">
        Nuestros logros hablan por nosotros
      </h2>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Años de dedicación, pasión y trabajo duro se reflejan en cada medalla y reconocimiento.
      </p>
    </div>

    <div class="section-reveal grid grid-cols-2 md:grid-cols-4 gap-8">
      {data.map((s) => (
        <div class="text-center group">
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-white/20 backdrop-blur-sm mb-4 group-hover:bg-white/30 transition-colors">
            <i class={`fas ${s.icon} text-white text-3xl`}></i>
          </div>
          {/* ✅ data-target como atributo HTML estándar */}
          <div class="text-4xl sm:text-5xl font-bold text-white counter" data-target={s.value}>0</div>
          <p class="text-white/80 mt-2 font-medium">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

{/* ✅ CORRECCIÓN: JavaScript puro, sin TypeScript */}
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const counters = document.querySelectorAll('.counter');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const el = entry.target;
        
        // ✅ Verificar que el elemento no haya sido animado ya
        if (entry.isIntersecting && !el.dataset.animated) {
          // ✅ Marcar como animado
          el.dataset.animated = 'true';
          
          // ✅ Obtener el valor target con fallback
          const targetValue = el.getAttribute('data-target');
          if (!targetValue) return;
          
          const target = parseInt(targetValue, 10);
          const duration = 2000;
          const start = performance.now();
          
          function updateCounter(currentTime) {
            const elapsed = currentTime - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const current = Math.floor(eased * target);
            
            // ✅ Actualizar el texto del elemento
            el.textContent = current + '+';
            
            if (progress < 1) {
              requestAnimationFrame(updateCounter);
            } else {
              // ✅ Asegurar que termine en el valor exacto
              el.textContent = target + '+';
            }
          }
          
          requestAnimationFrame(updateCounter);
        }
      });
    }, { threshold: 0.5 });
    
    counters.forEach(counter => observer.observe(counter));
  });
</script>