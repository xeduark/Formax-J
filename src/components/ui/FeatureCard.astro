---
// src/components/ui/FeatureCard.astro
import type { Feature } from '../../types';

export interface Props extends Feature {}

const { icon, title, description } = Astro.props;
---

<div class="p-4 bg-gray-50 rounded-xl hover:bg-blue-50 transition-colors group">
  <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">{icon}</div>
  <h4 class="font-semibold text-gray-900 mb-1">{title}</h4>
  <p class="text-sm text-gray-600">{description}</p>
</div>