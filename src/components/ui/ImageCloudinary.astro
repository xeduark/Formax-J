---
// src/components/ui/ImageCloudinary.astro
export interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  objectFit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down'; // ✅ Agregado
}

const {
  src,
  alt,
  class: className = '',
  width,
  height,
  loading = 'lazy',
  fetchpriority = 'auto',
  objectFit = 'cover'
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  class={`${className} transition-transform duration-300`}
  style={`object-fit: ${objectFit};`}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  {width}
  {height}
/>