---
export interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className = '', width, height, loading = 'lazy' } = Astro.props;
---

<img src={src} alt={alt} class={`${className} transition-transform duration-300`} loading={loading} decoding="async" {width} {height} />