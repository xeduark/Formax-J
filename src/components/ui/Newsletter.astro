---
// src/components/ui/Newsletter.astro
export interface Props {
  title?: string;
  placeholder?: string;
}

const { 
  title = 'Newsletter', 
  placeholder = 'tu@email.com' 
} = Astro.props;
---

<div>
  <h3 class="text-white font-semibold mb-2">{title}</h3>
  <p class="text-sm text-gray-400 mb-4">
    Suscríbete para recibir noticias, eventos y ofertas especiales.
  </p>
  <form class="flex gap-2" onsubmit="return false;">
    <input
      type="email"
      placeholder={placeholder}
      class="flex-1 px-4 py-2.5 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors text-sm"
    />
    <button
      type="submit"
      class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors text-sm whitespace-nowrap"
    >
      Suscribirme
    </button>
  </form>
</div>