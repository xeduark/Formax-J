---
// src/components/ui/ProgramCard.astro
import type { Program } from '../../types';
export interface Props extends Program {}
const { title, age, freq, desc, price, icon, gradient, popular, id } = Astro.props;
---

<div class="card-hover bg-white dark:bg-gray-900 rounded-3xl overflow-hidden shadow-lg border border-gray-100 dark:border-gray-700 relative group">
  {popular && (
    <span class="absolute top-4 right-4 px-3 py-1 bg-gradient-to-r from-yellow-400 to-yellow-500 text-white text-xs font-bold rounded-full">
      <i class="fas fa-fire mr-1"></i> Popular
    </span>
  )}
  <div class={`h-48 bg-gradient-to-br ${gradient} flex items-center justify-center relative overflow-hidden`}>
    <i class={`fas ${icon} text-white text-4xl mb-2`}></i>
    <h3 class="text-2xl font-bold text-white">{title}</h3>
  </div>
  <div class="p-6 space-y-4">
    <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
      <i class="fas fa-users mr-2 text-green-500"></i><span>{age}</span>
      <span class="mx-2">•</span>
      <i class="fas fa-clock mr-2 text-green-500"></i><span>{freq}</span>
    </div>
    <p class="text-gray-600 dark:text-gray-400">{desc}</p>
    <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
      <span class="text-2xl font-bold text-green-600 dark:text-green-400">{price}<span class="text-sm font-normal text-gray-500">/mes</span></span>
      <a href="#contacto" class="px-4 py-2 bg-green-600 text-white rounded-full text-sm font-medium hover:bg-green-700 transition-colors">Info <i class="fas fa-arrow-right ml-1"></i></a>
    </div>
  </div>
</div>