---
// src/components/ui/ProgramModal.astro
export interface Props {
  program: any;
  isOpen: boolean;
}
const { program, isOpen } = Astro.props;

if (!program) return null;

const whatsappNumber = '573122461761';
const whatsappMessage = encodeURIComponent(
  `Hola equipo FORMAX-J,\n\nEstoy interesado/a en el programa: ${program.title}\nNivel: ${program.level}\n\nMe gustaría recibir información sobre requisitos, horarios y proceso de inscripción.\n\nGracias.`
);
---

<div id="programModal" class={`fixed inset-0 z-[100] flex items-center justify-center p-4 transition-all duration-300 ${isOpen ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'}`}>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="modalBackdrop"></div>
  
  <!-- Modal Content -->
  <div class="relative bg-white dark:bg-gray-900 rounded-3xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto border border-gray-200 dark:border-gray-700 transform transition-transform duration-300 scale-95" id="modalContent">
    <button id="closeModal" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors z-10">
      <i class="fas fa-times text-gray-600 dark:text-gray-300"></i>
    </button>

    <div class="p-6 md:p-8">
      <!-- Header -->
      <div class={`h-24 rounded-2xl bg-gradient-to-br ${program.gradient} flex items-center justify-center mb-6 relative overflow-hidden`}>
        <i class="fas fa-rocket text-white/20 text-6xl absolute -bottom-2 -right-2"></i>
        <h3 class="text-2xl font-bold text-white relative z-10 text-center px-4">{program.title}</h3>
      </div>

      <!-- Level Badge -->
      <div class="flex items-center justify-center mb-6">
        <span class="px-4 py-1.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full text-sm font-bold border border-green-200 dark:border-green-800">
          <i class="fas fa-layer-group mr-1"></i> Nivel: {program.level}
        </span>
      </div>

      <!-- Details Grid -->
      <div class="grid grid-cols-2 gap-4 mb-6 text-center">
        <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl">
          <i class="fas fa-users text-green-500 mb-1"></i>
          <p class="text-xs text-gray-500 dark:text-gray-400">Edad</p>
          <p class="font-semibold text-gray-900 dark:text-white text-sm">{program.age}</p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl">
          <i class="fas fa-clock text-green-500 mb-1"></i>
          <p class="text-xs text-gray-500 dark:text-gray-400">Frecuencia</p>
          <p class="font-semibold text-gray-900 dark:text-white text-sm">{program.freq}</p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 p-3 rounded-xl col-span-2">
          <i class="fas fa-calendar-alt text-green-500 mb-1"></i>
          <p class="text-xs text-gray-500 dark:text-gray-400">Enfoque Metodológico</p>
          <p class="font-semibold text-gray-900 dark:text-white text-sm">{program.methodologyFocus}</p>
        </div>
      </div>

      <!-- Description -->
      <div class="mb-6">
        <h4 class="font-bold text-gray-900 dark:text-white mb-2">¿Qué aprenderás?</h4>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{program.desc}</p>
        <ul class="mt-3 space-y-2">
          {program.details?.map((d: string) => (
            <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
              <i class="fas fa-check text-green-500 mt-1 text-xs"></i> {d}
            </li>
          ))}
        </ul>
      </div>

      <!-- Price & CTA -->
      <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-700">
        <div>
          <span class="text-2xl font-bold text-green-600 dark:text-green-400">{program.price}</span>
          <span class="text-sm text-gray-500 dark:text-gray-400">/mes</span>
        </div>
        <a 
          href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-full font-semibold text-sm transition-colors shadow-lg hover:shadow-green-500/30 inline-flex items-center gap-2"
        >
          <i class="fab fa-whatsapp"></i> Inscribirme
        </a>
      </div>
    </div>
  </div>
</div>