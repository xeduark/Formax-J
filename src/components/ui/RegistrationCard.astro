---
// src/components/ui/RegistrationCard.astro
export interface Props {
  data: {
    price: string;
    includes: string[];
    note?: string;
  };
}

const { data } = Astro.props;
---

<div class="section-reveal mb-12 max-w-4xl mx-auto">
  <div class="bg-gradient-to-br from-green-50 to-yellow-50 dark:from-green-900/20 dark:to-yellow-900/20 border border-green-200 dark:border-green-800 rounded-3xl p-6 md:p-8 relative overflow-hidden shadow-lg">
    {/* Decoración */}
    <div class="absolute top-0 right-0 w-32 h-32 bg-green-400/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"></div>

    <div class="flex flex-col md:flex-row items-start md:items-center gap-6 relative z-10">
      {/* Precio */}
      <div class="flex-shrink-0 text-center md:text-left bg-white dark:bg-gray-800 rounded-2xl p-5 shadow-sm border border-green-100 dark:border-green-900/50 min-w-[180px]">
        <p class="text-xs font-bold text-green-600 dark:text-green-400 uppercase tracking-wider mb-1">
          Inscripción Única
        </p>
        <div class="text-4xl font-extrabold text-gray-900 dark:text-white">
          {data.price}
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
          Pago único anual
        </p>
      </div>

      {/* Incluye */}
      <div class="flex-1">
        <p class="font-semibold text-gray-800 dark:text-gray-100 mb-3 flex items-center gap-2">
          <i class="fas fa-gift text-yellow-500"></i> ¿Qué incluye tu inscripción?
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-y-2 gap-x-4">
          {data.includes.map((item) => (
            <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-200">
              <i class="fas fa-check-circle text-green-500 text-xs"></i> {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* Nota */}
    {data.note && (
      <div class="mt-6 pt-4 border-t border-green-200/60 dark:border-green-800/60 text-xs text-gray-500 dark:text-gray-400 flex items-start gap-2 bg-white/50 dark:bg-gray-900/30 p-3 rounded-lg">
        <i class="fas fa-info-circle text-blue-500 mt-0.5"></i>
        <span><strong>Nota:</strong> {data.note}</span>
      </div>
    )}

    {/* ✅ BOTÓN DE NAVEGACIÓN A /inscripcion */}
    <a
      href="/registration"
      class="w-full inline-flex items-center justify-center gap-3 bg-gradient-to-r from-green-600 to-green-500 hover:from-green-700 hover:to-green-600 text-white font-bold py-4 px-6 rounded-xl transition-all shadow-lg hover:shadow-green-500/30 active:scale-[0.98] text-sm font-display mt-6"
    >
      <i class="fas fa-arrow-right text-lg"></i>
      <span>Conoce más sobre la inscripción</span>
    </a>
  </div>
</div>