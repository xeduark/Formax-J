---
// src/components/ui/SectionTitle.astro
export interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  class?: string;
}

const { 
  title, 
  subtitle, 
  align = 'center', 
  class: className = '' 
} = Astro.props;

const alignments = {
  left: 'text-left',
  center: 'text-center mx-auto',
  right: 'text-right ml-auto'
};
---

<div class={`mb-12 ${alignments[align]} ${className}`}>
  <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{title}</h2>
  {subtitle && <p class="text-lg text-gray-600 max-w-2xl">{subtitle}</p>}
</div>