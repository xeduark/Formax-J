---
// src/components/ui/SponsorCard.astro
import type { Sponsor } from '../../types';
import ImageCloudinary from './ImageCloudinary.astro';

export interface Props extends Sponsor {
  featured?: boolean;
}

const { id, name, description, logo, url, featured = false } = Astro.props;
---

{featured ? (
  <a 
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="block bg-gradient-to-br from-blue-600 to-blue-800 rounded-2xl p-6 text-white hover:shadow-2xl transition-shadow"
  >
    <div class="flex items-start gap-4">
      <ImageCloudinary
        src={logo}
        alt={name}
        class="w-16 h-16 object-contain bg-white rounded-lg"
        width={64}
        height={64}
        objectFit="contain"
      />
      <div>
        <h4 class="font-bold text-lg mb-1">{name}</h4>
        <p class="text-blue-100 text-sm">{description}</p>
        <span class="inline-flex items-center gap-1 mt-3 text-sm font-medium">
          Visitar {name}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </span>
      </div>
    </div>
  </a>
) : (
  <a 
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center gap-3 px-4 py-2 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
  >
    <ImageCloudinary
      src={logo}
      alt={name}
      class="w-10 h-10 object-contain"
      width={40}
      height={40}
      objectFit="contain"
    />
    <span class="text-sm font-medium text-gray-700">{name}</span>
  </a>
)}