---
// src/components/sections/RegistrationSection.astro
// Sección Completa Interactiva con Tabs - Diseño FORMAX-J
import { registrationData } from "@data/registration";

export interface Props {
  data?: typeof registrationData;
  imageSrc?: string;
}

const {
  data = registrationData,
  imageSrc = "https://res.cloudinary.com/cx3z2ry1/image/upload/v1787281386/formax_skating_club_1787257691604_imzjdm.jpg",
} = Astro.props;
---

<section
  id="inscripcion-formax-full"
  class="py-24 bg-white dark:bg-gray-900 relative overflow-hidden"
>
  {/* Decoraciones de fondo */}
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-green-100/50 dark:bg-green-900/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-64 h-64 bg-yellow-100/50 dark:bg-yellow-900/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none"
  >
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Header de Sección */}
    <div class="section-reveal text-center max-w-3xl mx-auto mb-12">
      <span
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-semibold mb-6 border border-green-200 dark:border-green-800"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"
          ></span>
        </span>
        Temporada 2026 • Cupos Abiertos
      </span>

      <h2
        class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white mb-4 leading-tight tracking-tight"
      >
        {
          (() => {
            const fullTitle =
              data.title || "Inscripción y Afiliación Deportiva";
            const parts = fullTitle.split("Deportiva");

            // Si "Deportiva" está en el título, lo separamos para aplicar el gradient
            if (parts.length === 2) {
              return (
                <>
                  {parts[0]}
                  <span class="gradient-text">Deportiva</span>
                  {parts[1]}
                </>
              );
            }
            // Si no, renderizamos el título completo sin modificación
            return fullTitle;
          })()
        }
      </h2>

      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        {
          data.subtitle ||
            "Sé parte de nuestra academia de patinaje y entrena con disciplina, técnica y pasión."
        }
      </p>
    </div>

    {/* Card Principal Dividida */}
    <div
      class="section-reveal grid grid-cols-1 lg:grid-cols-12 items-stretch bg-white dark:bg-gray-800 rounded-3xl border border-gray-200 dark:border-gray-700 shadow-xl overflow-hidden card-hover"
    >
      {/* Columna Izquierda: Imagen */}
      <div
        class="lg:col-span-5 relative bg-gradient-to-br from-green-600 to-yellow-500 flex flex-col justify-between overflow-hidden group min-h-[380px] lg:min-h-full"
      >
        <img
          src={imageSrc}
          alt="Club de Patinaje FORMAX-J"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700 opacity-90 mix-blend-overlay"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40 to-transparent"
        >
        </div>

        {/* Badge Superior */}
        <div class="relative z-10 p-6 flex justify-between items-start">
          <span
            class="bg-white/95 backdrop-blur-md text-gray-900 font-bold text-xs uppercase px-3 py-1.5 rounded-lg shadow-sm border border-white/40 font-display"
          >
            {data.clubName || "Club FORMAX-J"}
          </span>
          <span
            class="bg-green-500/90 text-white font-medium text-xs px-2.5 py-1 rounded-full shadow-xs flex items-center gap-1"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"
            ></span>
            Inscripciones Abiertas
          </span>
        </div>

        {/* Caption Inferior */}
        <div class="relative z-10 p-6 text-white space-y-3 mt-auto">
          <div
            class="inline-block bg-yellow-500/90 backdrop-blur-md text-gray-900 text-xs px-3 py-1.5 rounded-md font-bold font-display"
          >
            Formación & Rendimiento
          </div>
          <h3 class="text-xl font-bold text-white leading-snug font-display">
            Desarrolla tu potencial deportivo sobre ruedas
          </h3>
          <p class="text-white/90 text-xs sm:text-sm line-clamp-2">
            Entrenamientos guiados por profesionales, metodología progresiva e
            indumentaria técnica oficial.
          </p>
        </div>
      </div>

      {/* Columna Derecha: Contenido + Tabs */}
      <div
        class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between space-y-6"
      >
        <div>
          {/* Precio Principal */}
          <div
            class="flex flex-col sm:flex-row sm:items-baseline justify-between pb-5 border-b border-gray-100 dark:border-gray-700 gap-3"
          >
            <div>
              <span
                class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 block mb-1"
              >
                {data.pricePeriod || "Valor de Inscripción"}
              </span>
              <div class="flex items-baseline gap-2">
                <span
                  class="text-4xl sm:text-5xl font-black text-green-600 dark:text-green-400 tracking-tight font-display"
                >
                  {data.price}
                </span>
                <span
                  class="text-xs font-medium text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 px-2.5 py-1 rounded-md"
                >
                  COP
                </span>
              </div>
            </div>

            <div
              class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 dark:text-green-300 bg-green-100 dark:bg-green-900/30 px-3 py-1.5 rounded-full self-start sm:self-auto border border-green-200 dark:border-green-800"
            >
              <i class="fas fa-calendar-check text-xs"></i>
              <span>Pago Único de Afiliación</span>
            </div>
          </div>

          {/* Botones de Tabs */}
          <div
            class="flex border-b border-gray-100 dark:border-gray-700 mt-6 mb-6 gap-4 sm:gap-8 overflow-x-auto pb-1"
            id="astro-tab-group"
          >
            <button
              type="button"
              data-tab="beneficios"
              class="tab-btn pb-2.5 text-sm font-bold text-green-600 dark:text-green-400 border-b-2 border-green-600 dark:border-green-400 transition-colors whitespace-nowrap cursor-pointer font-display"
            >
              ¿Qué incluye? ({data.includes.length})
            </button>

            {
              data.requirements && (
                <button
                  type="button"
                  data-tab="requisitos"
                  class="tab-btn pb-2.5 text-sm font-semibold text-gray-500 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 transition-colors whitespace-nowrap cursor-pointer font-display"
                >
                  Requisitos ({data.requirements.length})
                </button>
              )
            }

            {
              data.faq && (
                <button
                  type="button"
                  data-tab="faq"
                  class="tab-btn pb-2.5 text-sm font-semibold text-gray-500 dark:text-gray-400 hover:text-green-600 dark:hover:text-green-400 transition-colors whitespace-nowrap cursor-pointer font-display"
                >
                  Preguntas Frecuentes
                </button>
              )
            }
          </div>

          {/* Panel 1: Beneficios */}
          <div id="tab-panel-beneficios" class="tab-panel space-y-3">
            <p
              class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-3 flex items-center gap-2"
            >
              <i class="fas fa-gift text-yellow-500"></i>
              Beneficios y dotación incluidos:
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {
                data.includes.map((item) => (
                  <div class="flex items-center gap-3 p-3.5 rounded-xl bg-gray-50 dark:bg-gray-700/50 border border-gray-100 dark:border-gray-600 hover:bg-green-50 dark:hover:bg-green-900/20 transition-colors">
                    <div class="p-1.5 rounded-lg bg-white dark:bg-gray-800 shadow-xs border border-gray-200 dark:border-gray-600 text-green-600 dark:text-green-400">
                      <i class="fas fa-check text-xs" />
                    </div>
                    <span class="text-sm font-medium text-gray-800 dark:text-gray-200">
                      {item}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          {/* Panel 2: Requisitos */}
          {
            data.requirements && (
              <div id="tab-panel-requisitos" class="tab-panel hidden space-y-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-3 flex items-center gap-2">
                  <i class="fas fa-clipboard-list text-green-500" />
                  Documentación necesaria:
                </p>
                <ul class="space-y-2.5">
                  {data.requirements.map((req, i) => (
                    <li class="flex items-start gap-3 text-sm text-gray-700 dark:text-gray-300 bg-gray-50 dark:bg-gray-700/50 p-3.5 rounded-xl border border-gray-100 dark:border-gray-600">
                      <span class="flex-shrink-0 w-6 h-6 rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 flex items-center justify-center font-bold text-[10px]">
                        {i + 1}
                      </span>
                      <span class="leading-relaxed">{req}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {/* Panel 3: FAQ (Acordeón) */}
          {
            data.faq && (
              <div id="tab-panel-faq" class="tab-panel hidden space-y-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500 mb-3 flex items-center gap-2">
                  <i class="fas fa-question-circle text-yellow-500" />
                  Resolvemos tus dudas:
                </p>
                <div class="space-y-2.5">
                  {data.faq.map((item, idx) => (
                    <details
                      class="group border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-700/50 overflow-hidden transition-all open:bg-white dark:open:bg-gray-800 open:border-green-300 dark:open:border-green-700"
                    >
                      <summary class="flex justify-between items-center p-4 text-sm font-semibold text-gray-800 dark:text-gray-200 cursor-pointer list-none select-none hover:text-green-600 dark:hover:text-green-400 transition-colors">
                        <span>{item.question}</span>
                        <span class="ml-2 text-gray-400 group-open:rotate-180 transition-transform duration-200">
                          <i class="fas fa-chevron-down text-xs" />
                        </span>
                      </summary>
                      <div class="px-4 pb-4 text-sm text-gray-600 dark:text-gray-400 border-t border-gray-200 dark:border-gray-700 pt-3 leading-relaxed">
                        {item.answer}
                      </div>
                    </details>
                  ))}
                </div>
              </div>
            )
          }

          {/* Nota Importante */}
          <div
            class="mt-8 p-4 rounded-2xl bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 dark:border-yellow-800 flex items-start gap-3"
          >
            <i
              class="fas fa-exclamation-circle text-yellow-600 dark:text-yellow-400 mt-0.5"
            ></i>
            <div class="space-y-1">
              <span
                class="text-xs font-bold uppercase tracking-wider text-yellow-800 dark:text-yellow-200 block"
              >
                Información Importante
              </span>
              <p
                class="text-sm text-yellow-800/90 dark:text-yellow-200/90 leading-relaxed"
              >
                {data.note}
              </p>
            </div>
          </div>
        </div>

        {
          /* ==========================================
    BOTONES DE ACCIÓN (Modal + WhatsApp)
========================================== */
        }
        <div
          class="pt-4 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row gap-3"
        >
          {/* ✅ Botón 1: Abrir Modal de Pre-Inscripción */}
          <button
            type="button"
            data-open-enroll-modal
            class="flex-1 inline-flex items-center justify-center gap-3 bg-gradient-to-r from-green-600 to-green-500 hover:from-green-700 hover:to-green-600 text-white font-bold py-4 px-6 rounded-xl transition-all shadow-lg hover:shadow-green-500/30 active:scale-[0.98] text-sm font-display cursor-pointer"
          >
            <i class="fas fa-user-plus text-lg"></i>
            <span>Pre-Inscripción</span>
          </button>

          {/* ✅ Botón 2: WhatsApp (alternativa) */}
          <a
            href={`https://wa.me/${data.whatsappContact || "573001234567"}?text=${encodeURIComponent(`Hola ${data.clubName || "equipo FORMAX-J"}, deseo realizar la inscripción por el valor de ${data.price}. ¿Me pueden orientar con el proceso?`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-3 border-2 border-green-600 dark:border-green-400 text-green-700 dark:text-green-300 hover:bg-green-50 dark:hover:bg-green-900/20 font-bold py-4 px-6 rounded-xl transition-all text-sm font-display"
          >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Consultar por WhatsApp</span>
          </a>
        </div>

        <p
          class="text-[10px] text-gray-400 dark:text-gray-500 text-center mt-3"
        >
          Respuesta en menos de 24 horas ⚡
        </p>
      </div>
    </div>
  </div>
</section>

{/* Script de Tabs - Vanilla JS (Zero overhead) */}
<script is:inline>
  function setupAstroTabs() {
    const tabButtons = document.querySelectorAll("#astro-tab-group .tab-btn");
    const tabPanels = document.querySelectorAll(".tab-panel");

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = btn.getAttribute("data-tab");

        // Resetear todos los botones
        tabButtons.forEach((b) => {
          b.classList.remove(
            "text-green-600",
            "dark:text-green-400",
            "border-b-2",
            "border-green-600",
            "dark:border-green-400",
            "font-bold",
          );
          b.classList.add(
            "text-gray-500",
            "dark:text-gray-400",
            "font-semibold",
          );
        });

        // Activar botón seleccionado
        btn.classList.remove(
          "text-gray-500",
          "dark:text-gray-400",
          "font-semibold",
        );
        btn.classList.add(
          "text-green-600",
          "dark:text-green-400",
          "border-b-2",
          "border-green-600",
          "dark:border-green-400",
          "font-bold",
        );

        // Mostrar/ocultar paneles
        tabPanels.forEach((panel) => {
          if (panel.id === `tab-panel-${targetTab}`) {
            panel.classList.remove("hidden");
          } else {
            panel.classList.add("hidden");
          }
        });
      });
    });
  }

  // Inicializar en carga inicial + navegación Astro
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAstroTabs);
  } else {
    setupAstroTabs();
  }

  // Para Astro con view transitions
  document.addEventListener("astro:after-swap", setupAstroTabs);
</script>
