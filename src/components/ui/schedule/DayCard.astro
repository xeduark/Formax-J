---
import type { DayCardProps } from '../../../types/schedule';
import SlotCard from './SlotCard.astro';
export interface Props extends DayCardProps {}
const { day }: Props = Astro.props;

const isSpecial = day.isSpecial;
const headerGradient = isSpecial ? 'from-yellow-500 to-amber-600' : 'from-green-600 to-green-500';
const cardBorder = isSpecial ? 'border-yellow-300 dark:border-yellow-700' : 'border-gray-200 dark:border-gray-700';
const cardBg = isSpecial ? 'bg-yellow-50/30 dark:bg-yellow-900/10' : 'bg-gray-50/50 dark:bg-gray-800/40';
---

<div class={`section-reveal rounded-3xl border ${cardBorder} ${cardBg} shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col overflow-hidden backdrop-blur-sm card-hover full min-h-[265px]`}>
  <div class={`p-4 border-b border-white/10 bg-gradient-to-r ${headerGradient} text-white flex flex-col justify-center min-h-[75px]`}>
    <div class="flex items-center justify-between mb-1">
      <h3 class="font-display text-lg font-bold tracking-wide uppercase">{day.dayName}</h3>
      {isSpecial && <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-white/20 backdrop-blur-sm animate-pulse">🏁 PISTA</span>}
    </div>
    <p class="text-xs font-medium opacity-90">{day.subtitle}</p>
  </div>
  <div class="p-4 space-y-4 flex-1 flex flex-col justify-start">
    {day.slots.map((slot, index) => (
      <SlotCard scheduleSlot={slot} isLast={index === day.slots.length - 1} />
    ))}
  </div>
</div>