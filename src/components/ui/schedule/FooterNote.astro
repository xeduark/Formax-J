---
import type { FooterNoteProps } from '../../../types/schedule';
export interface Props extends FooterNoteProps {}
const { html }: Props = Astro.props;
---

{html && (
  <div class="section-reveal mt-6 p-4 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 text-center">
    <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed" set:html={html}></p>
  </div>
)}