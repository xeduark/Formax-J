---
import type { SectionHeaderProps } from '../../../types/schedule';
export interface Props extends SectionHeaderProps {}
const { badge, title, subtitle }: Props = Astro.props;
---

<div class="section-reveal text-center mb-12">
  {badge && (
    <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-semibold mb-6 border border-green-200 dark:border-green-800">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
      </span>
      {badge}
    </span>
  )}
  <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-4 leading-tight tracking-tight">{title}</h2>
  {subtitle && <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-2">{subtitle}</p>}
</div>