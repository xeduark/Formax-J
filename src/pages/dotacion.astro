---
// src/pages/dotacion.astro
import MainLayout from '../layouts/MainLayout.astro';
import { DOTACION_ITEMS, DOTACION_PACKAGES, SIZE_RECOMMENDATIONS, TRACK_STATS } from '../data/dotacion';
import SuitViewer3D from '../components/sections/SuitViewer3D.astro';

const title = 'Dotación Oficial | Club de Patinaje FORMAX-J x Cityrun';
const description =
  'Enterizo aerodinámico de velocidad, camiseta Dry-Fit, medias de compresión y tula oficial del Club FORMAX-J con patrocinio técnico de Cityrun. Combos, guía de tallas y cotizador.';

const cop = (value: number) =>
  new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(value);

const whatsapp = '573122461761';
const allSizes = [...new Set(SIZE_RECOMMENDATIONS.map((s) => s.size))];
---

<MainLayout title={title} description={description}>
  <!-- ===== HERO ===== -->
  <section
    id="dotacion"
    class="relative pt-32 pb-20 bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 overflow-hidden"
  >
    <img
      src="/dotacion/track-action.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/60 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-green-500/10 border border-green-500/30 text-green-400 text-xs font-bold uppercase tracking-wider mb-5">
        <span class="w-2 h-2 rounded-full bg-green-400 animate-ping"></span>
        Dotación oficial 2026 · FORMAX-J x Cityrun
      </span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-white leading-tight max-w-3xl">
        Indumentaria técnica de <span class="gradient-text">velocidad</span>
      </h1>
      <p class="text-lg text-gray-300 mt-5 max-w-2xl">
        Enterizo aerodinámico Speed-Rib, camiseta Dry-Fit de entrenamiento y accesorios del club,
        con precios de preventa subsidiados para deportistas inscritos.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a
          href="#modelado"
          class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-600 to-green-500 text-white rounded-full font-semibold shadow-lg hover:shadow-green-500/30 hover:scale-105 transition-all"
        >
          <i class="fas fa-cube mr-2"></i>Ver en 3D
        </a>
        <a
          href="#tallas"
          class="inline-flex items-center px-6 py-3 rounded-full font-semibold text-white border border-white/25 hover:bg-white/10 transition-colors"
        >
          <i class="fas fa-ruler mr-2"></i>Guía de tallas
        </a>
      </div>
    </div>
  </section>

  <!-- ===== DATOS DE PISTA ===== -->
  <section class="py-14 bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
      {TRACK_STATS.map((stat) => (
        <div class="rounded-2xl border border-gray-800 bg-gray-900/60 p-5">
          <span class="text-[10px] font-bold uppercase tracking-wider text-yellow-400">{stat.badge}</span>
          <div class="text-2xl sm:text-3xl font-bold text-white mt-2">{stat.value}</div>
          <div class="text-sm font-semibold text-gray-300 mt-1">{stat.label}</div>
          <p class="text-xs text-gray-500 mt-2 leading-relaxed">{stat.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <SuitViewer3D />

  <!-- ===== PRENDAS ===== -->
  <section id="prendas" class="py-24 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
          <i class="fas fa-tshirt mr-1"></i> Prendas y accesorios
        </span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white">
          La dotación, <span class="gradient-text">pieza por pieza</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {DOTACION_ITEMS.map((item) => (
          <article class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 overflow-hidden flex flex-col card-hover">
            <div class="relative h-52 overflow-hidden">
              <img src={item.image} alt={item.name} loading="lazy" class="w-full h-full object-cover" />
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/70 text-white text-[11px] font-bold uppercase tracking-wider">
                {item.tag}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col">
              <h3 class="font-display text-xl font-bold text-gray-900 dark:text-white">{item.name}</h3>
              <p class="text-xs text-green-600 dark:text-green-400 font-semibold mt-1">{item.subtitle}</p>
              <p class="text-sm text-gray-600 dark:text-gray-400 mt-3 leading-relaxed">{item.description}</p>

              <ul class="mt-5 space-y-2">
                {item.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
                    <i class="fas fa-check text-green-500 mt-1 text-xs"></i>{feature}
                  </li>
                ))}
              </ul>

              <dl class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="bg-white dark:bg-gray-900 rounded-xl p-3 border border-gray-100 dark:border-gray-700">
                  <dt class="text-gray-500 dark:text-gray-400">Material</dt>
                  <dd class="font-semibold text-gray-900 dark:text-white mt-0.5">{item.techSpecs.material}</dd>
                </div>
                <div class="bg-white dark:bg-gray-900 rounded-xl p-3 border border-gray-100 dark:border-gray-700">
                  <dt class="text-gray-500 dark:text-gray-400">Ajuste</dt>
                  <dd class="font-semibold text-gray-900 dark:text-white mt-0.5">{item.techSpecs.fit}</dd>
                </div>
                <div class="bg-white dark:bg-gray-900 rounded-xl p-3 border border-gray-100 dark:border-gray-700">
                  <dt class="text-gray-500 dark:text-gray-400">Aerodinámica</dt>
                  <dd class="font-semibold text-gray-900 dark:text-white mt-0.5">{item.techSpecs.dragReduction}</dd>
                </div>
                <div class="bg-white dark:bg-gray-900 rounded-xl p-3 border border-gray-100 dark:border-gray-700">
                  <dt class="text-gray-500 dark:text-gray-400">Protección UV</dt>
                  <dd class="font-semibold text-gray-900 dark:text-white mt-0.5">{item.techSpecs.uvProtection}</dd>
                </div>
                {item.techSpecs.chamois && (
                  <div class="bg-white dark:bg-gray-900 rounded-xl p-3 border border-gray-100 dark:border-gray-700 sm:col-span-2">
                    <dt class="text-gray-500 dark:text-gray-400">Badana</dt>
                    <dd class="font-semibold text-gray-900 dark:text-white mt-0.5">{item.techSpecs.chamois}</dd>
                  </div>
                )}
              </dl>

              <div class="mt-6 pt-5 border-t border-gray-200 dark:border-gray-700 flex items-end justify-between gap-4">
                <div>
                  <div class="text-xs text-gray-400 line-through">{cop(item.basePrice)}</div>
                  <div class="text-2xl font-bold text-green-600 dark:text-green-400">{cop(item.promoPrice)}</div>
                  <div class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5">
                    Tallas: {item.sizes.join(' · ')}
                  </div>
                </div>
                <a
                  href="#cotizador"
                  class="shrink-0 inline-flex items-center px-4 py-2.5 rounded-full bg-gray-900 dark:bg-gray-700 text-white text-sm font-semibold hover:bg-green-600 dark:hover:bg-green-600 transition-colors"
                >
                  <i class="fas fa-plus mr-2"></i>Cotizar
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== COMBOS ===== -->
  <section id="combos" class="py-24 bg-gray-50 dark:bg-gray-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="inline-block px-4 py-1.5 rounded-full bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300 text-sm font-medium mb-4">
          <i class="fas fa-star mr-1"></i> Tarifas con subsidio del club
        </span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white">
          Combos de <span class="gradient-text">dotación</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {DOTACION_PACKAGES.map((pkg) => (
          <div
            class={`relative rounded-3xl p-7 flex flex-col bg-white dark:bg-gray-900 ${
              pkg.popular
                ? 'border-2 border-green-500 shadow-2xl md:scale-105'
                : 'border border-gray-200 dark:border-gray-700'
            }`}
          >
            <div class="flex items-center justify-between gap-2 mb-4">
              <span
                class={`text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full ${
                  pkg.popular
                    ? 'bg-green-500 text-white'
                    : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300'
                }`}
              >
                {pkg.badge}
              </span>
              <span class="text-xs font-bold text-yellow-600 dark:text-yellow-400">
                Ahorras {cop(pkg.savings)}
              </span>
            </div>

            <h3 class="font-display text-xl font-bold text-gray-900 dark:text-white">{pkg.name}</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 mt-2 leading-relaxed">{pkg.description}</p>

            <div class="my-6 p-4 rounded-2xl bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
              <div class="text-xs text-gray-400 line-through font-semibold">Antes {cop(pkg.originalPrice)}</div>
              <div class="text-3xl font-bold text-green-600 dark:text-green-400 mt-0.5">{cop(pkg.comboPrice)}</div>
              <div class="text-[11px] text-gray-500 dark:text-gray-400 font-semibold mt-1">
                <i class="fas fa-check text-green-500 mr-1"></i>Contado o 2 cuotas
              </div>
            </div>

            <div class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">
              Prendas incluidas
            </div>
            <ul class="space-y-2.5 flex-1">
              {pkg.itemsIncluded.map((included) => (
                <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
                  <i class="fas fa-check text-green-500 mt-1 text-xs"></i>{included}
                </li>
              ))}
            </ul>

            <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-5 pt-4 border-t border-gray-100 dark:border-gray-700">
              <i class="fas fa-user-group mr-1"></i>{pkg.target}
            </p>

            <a
              href="#cotizador"
              class="mt-5 py-3 px-6 rounded-full text-center font-semibold transition-all bg-gradient-to-r from-green-600 to-green-500 text-white hover:shadow-lg hover:shadow-green-500/30"
            >
              Cotizar este combo
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== GUÍA DE TALLAS ===== -->
  <section id="tallas" class="py-24 bg-white dark:bg-gray-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
          <i class="fas fa-ruler-combined mr-1"></i> Medidas de referencia
        </span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white">
          Guía de <span class="gradient-text">tallas</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-3 max-w-2xl mx-auto">
          Mide sobre ropa interior y sin apretar la cinta. Ante la duda entre dos tallas, elige la mayor:
          el enterizo es de corte segunda piel.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-gray-200 dark:border-gray-700">
        <table class="w-full text-sm min-w-[720px]">
          <thead class="bg-gray-50 dark:bg-gray-800">
            <tr class="text-left text-gray-500 dark:text-gray-400 text-xs uppercase tracking-wider">
              <th class="p-4 font-bold">Talla</th>
              <th class="p-4 font-bold">Categoría</th>
              <th class="p-4 font-bold">Estatura</th>
              <th class="p-4 font-bold">Peso</th>
              <th class="p-4 font-bold">Pecho</th>
              <th class="p-4 font-bold">Cintura</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            {SIZE_RECOMMENDATIONS.map((size) => (
              <tr class="hover:bg-green-50/50 dark:hover:bg-green-900/10 transition-colors">
                <td class="p-4 font-bold text-green-600 dark:text-green-400 whitespace-nowrap">{size.size}</td>
                <td class="p-4 text-gray-700 dark:text-gray-300">{size.skaterCategory}</td>
                <td class="p-4 text-gray-600 dark:text-gray-400 whitespace-nowrap">{size.heightRange}</td>
                <td class="p-4 text-gray-600 dark:text-gray-400 whitespace-nowrap">{size.weightRange}</td>
                <td class="p-4 text-gray-600 dark:text-gray-400 whitespace-nowrap">{size.chestRange}</td>
                <td class="p-4 text-gray-600 dark:text-gray-400 whitespace-nowrap">{size.waistRange}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===== COTIZADOR ===== -->
  <section id="cotizador" class="py-24 bg-gray-50 dark:bg-gray-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
          <i class="fab fa-whatsapp mr-1"></i> Preventa
        </span>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-gray-900 dark:text-white">
          Arma tu <span class="gradient-text">pedido</span>
        </h2>
        <p class="text-gray-600 dark:text-gray-400 mt-3">
          Selecciona cantidades, completa los datos y envía el pedido por WhatsApp para confirmar cupo de confección.
        </p>
      </div>

      <form id="quoteForm" class="rounded-3xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 p-6 sm:p-8 space-y-8">
        <!-- Combos -->
        <fieldset>
          <legend class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
            Combos
          </legend>
          <div class="space-y-3">
            {DOTACION_PACKAGES.map((pkg) => (
              <div class="flex items-center gap-4 p-4 rounded-2xl border border-gray-200 dark:border-gray-700">
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-gray-900 dark:text-white text-sm truncate">{pkg.name}</p>
                  <p class="text-xs text-green-600 dark:text-green-400 font-bold">{cop(pkg.comboPrice)}</p>
                </div>
                <input
                  type="number"
                  min="0"
                  value="0"
                  class="quote-qty w-20 px-3 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-center focus:ring-2 focus:ring-green-500 outline-none"
                  data-price={pkg.comboPrice}
                  data-name={pkg.name}
                  aria-label={`Cantidad de ${pkg.name}`}
                />
              </div>
            ))}
          </div>
        </fieldset>

        <!-- Prendas sueltas -->
        <fieldset>
          <legend class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
            Prendas sueltas
          </legend>
          <div class="space-y-3">
            {DOTACION_ITEMS.map((item) => (
              <div class="flex items-center gap-4 p-4 rounded-2xl border border-gray-200 dark:border-gray-700">
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-gray-900 dark:text-white text-sm truncate">{item.name}</p>
                  <p class="text-xs text-green-600 dark:text-green-400 font-bold">{cop(item.promoPrice)}</p>
                </div>
                <input
                  type="number"
                  min="0"
                  value="0"
                  class="quote-qty w-20 px-3 py-2 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white text-center focus:ring-2 focus:ring-green-500 outline-none"
                  data-price={item.promoPrice}
                  data-name={item.name}
                  aria-label={`Cantidad de ${item.name}`}
                />
              </div>
            ))}
          </div>
        </fieldset>

        <!-- Datos del deportista -->
        <fieldset class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <legend class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-4">
            Datos del deportista
          </legend>
          <input
            id="qName"
            required
            placeholder="Nombre del patinador *"
            class="px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          />
          <input
            id="qNumber"
            placeholder="Dorsal (ej. 07)"
            class="px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          />
          <select
            id="qSize"
            class="px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          >
            <option value="">Talla principal…</option>
            {allSizes.map((size) => <option value={size}>{size}</option>)}
          </select>
          <input
            id="qCategory"
            placeholder="Categoría (ej. Pre-Juvenil)"
            class="px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          />
          <input
            id="qParent"
            placeholder="Acudiente / contacto"
            class="px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          />
          <input
            id="qPhone"
            type="tel"
            placeholder="Teléfono de contacto"
            class="px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          />
          <textarea
            id="qNotes"
            rows="2"
            placeholder="Observaciones (opcional)"
            class="sm:col-span-2 px-4 py-3 rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-green-500 outline-none"
          ></textarea>
        </fieldset>

        <!-- Total + envío -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5 pt-6 border-t border-gray-200 dark:border-gray-700">
          <div>
            <p class="text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-bold">Total preventa</p>
            <p id="quoteTotal" class="text-4xl font-bold text-green-600 dark:text-green-400">$ 0</p>
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-green-500 text-white font-semibold text-lg shadow-lg hover:bg-green-600 hover:shadow-green-500/30 transition-all"
          >
            <i class="fab fa-whatsapp mr-2 text-xl"></i>Enviar pedido
          </button>
        </div>
        <p id="quoteError" class="text-sm text-red-600 dark:text-red-400 hidden">
          Agrega al menos un combo o prenda y escribe el nombre del patinador.
        </p>
      </form>
    </div>
  </section>
</MainLayout>

<script is:inline define:vars={{ whatsapp }}>
  (() => {
    const form = document.getElementById('quoteForm');
    if (!form) return;

    const totalEl = document.getElementById('quoteTotal');
    const errorEl = document.getElementById('quoteError');
    const qtyInputs = [...form.querySelectorAll('.quote-qty')];
    const cop = new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      maximumFractionDigits: 0,
    });

    const lines = () =>
      qtyInputs
        .map((input) => ({
          name: input.dataset.name,
          price: Number(input.dataset.price),
          qty: Math.max(0, Number(input.value) || 0),
        }))
        .filter((line) => line.qty > 0);

    const total = () => lines().reduce((sum, line) => sum + line.price * line.qty, 0);

    const render = () => {
      totalEl.textContent = cop.format(total());
    };

    qtyInputs.forEach((input) => input.addEventListener('input', render));
    render();

    const value = (id) => document.getElementById(id).value.trim();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const selected = lines();
      const name = value('qName');

      if (selected.length === 0 || !name) {
        errorEl.classList.remove('hidden');
        return;
      }
      errorEl.classList.add('hidden');

      const rows = [
        '*PEDIDO DE DOTACION - CLUB DE PATINAJE FORMAX-J*',
        '',
        'Patinador(a): ' + name,
      ];
      if (value('qNumber')) rows.push('Dorsal: #' + value('qNumber'));
      if (value('qCategory')) rows.push('Categoria: ' + value('qCategory'));
      if (value('qSize')) rows.push('Talla principal: ' + value('qSize'));
      if (value('qParent')) rows.push('Acudiente: ' + value('qParent'));
      if (value('qPhone')) rows.push('Telefono: ' + value('qPhone'));

      rows.push('', '*DETALLE DEL PEDIDO:*');
      selected.forEach((line, i) => {
        rows.push(`${i + 1}. ${line.name} (x${line.qty}) - ${cop.format(line.price * line.qty)}`);
      });

      rows.push('', '*TOTAL PREVENTA:* ' + cop.format(total()));
      if (value('qNotes')) rows.push('Observaciones: ' + value('qNotes'));
      rows.push('', 'Solicito confirmacion de cupo de confeccion y datos para el pago.');

      window.open('https://wa.me/' + whatsapp + '?text=' + encodeURIComponent(rows.join('\n')), '_blank');
    });
  })();
</script>
