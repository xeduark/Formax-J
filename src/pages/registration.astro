---
// src/pages/registration.astro
import MainLayout from '../layouts/MainLayout.astro';

// ✅ Sección completa → components/sections/
import RegistrationSection from '@components/ui/registration/RegistrationCard.astro';

// ✅ Componente atómico → components/ui/
import RegistrationModal from '@components/ui/registration/RegistrationModal.astro';

import { registrationData } from '../data/registration';
import PaymentPanel from '@components/ui/PaymentPanel.astro';
import { fromSanity, QUERY_PAGOS, QUERY_INSCRIPCION } from '../lib/sanity';
import { paymentConfig } from '../data/payments';

const pagos = await fromSanity(QUERY_PAGOS, paymentConfig);
const inscripcion = await fromSanity(QUERY_INSCRIPCION, registrationData);

// Meta tags para SEO
const title = 'Inscripción | Club Deportivo FORMAX-J';
const description = 'Únete al Club FORMAX-J. Proceso de afiliación, requisitos y preguntas frecuentes para patinaje de velocidad en línea.';
---

<MainLayout title={title} description={description}>
  {/* Sección principal de inscripción */}
  <RegistrationSection data={inscripcion}
  />
  
  {/* Pago de inscripción */}
  <section id="pago" class="py-20 bg-white dark:bg-gray-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="inline-block px-4 py-1.5 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-sm font-medium mb-4">
          <i class="fas fa-wallet mr-1"></i> Medios de pago
        </span>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
          Paga tu <span class="gradient-text">inscripción</span>
        </h2>
      </div>
      <PaymentPanel
        concepto="Inscripción y primera mensualidad"
        config={pagos}
        nota="El valor depende del programa. Confírmalo con el club antes de transferir."
      />
    </div>
  </section>

  {/* Acceso a la dotación oficial */}
  <section class="py-20 bg-gray-50 dark:bg-gray-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href="/dotacion"
        class="group block rounded-3xl overflow-hidden border border-gray-200 dark:border-gray-700 bg-gray-900 relative card-hover"
      >
        <img
          src="/dotacion/sprint-pack.jpg"
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover opacity-30 group-hover:opacity-40 transition-opacity duration-500"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent"></div>

        <div class="relative p-8 sm:p-12">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-500/15 border border-yellow-500/30 text-yellow-400 text-xs font-bold uppercase tracking-wider mb-5">
            <i class="fas fa-shirt"></i> Dotación oficial · FORMAX-J x Cityrun
          </span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-white max-w-xl leading-tight">
            Conoce la dotación oficial del club
          </h2>
          <p class="text-gray-300 mt-4 max-w-xl">
            Enterizo aerodinámico de velocidad, camiseta Dry-Fit, medias de compresión y tula.
            Combos con subsidio del club, guía de tallas y cotizador para enviar tu pedido por WhatsApp.
          </p>
          <span class="inline-flex items-center mt-8 px-6 py-3 bg-gradient-to-r from-green-600 to-green-500 text-white rounded-full font-semibold shadow-lg group-hover:shadow-green-500/30 group-hover:scale-105 transition-all">
            Ver dotación y precios<i class="fas fa-arrow-right ml-2"></i>
          </span>
        </div>
      </a>
    </div>
  </section>

  {/* Modal de pre-inscripción (oculto por defecto) */}
  <RegistrationModal data={inscripcion} />
</MainLayout>